<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Housekeeping.Installer</AssemblyName>
    <RootNamespace>Housekeeping.Installer</RootNamespace>
    <Product>Housekeeping</Product>
    <Company>StreamItAll</Company>
    <Description>Housekeeping Self-Contained Windows Setup and Uninstaller</Description>
    <Version Condition="'$(InstallerVersion)' != ''">$(InstallerVersion)</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <ApplicationIcon Condition="'$(InstallerIconPath)' != '' and Exists('$(InstallerIconPath)')">$(InstallerIconPath)</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/,$(USERPROFILE)=/user/</PathMap>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(InstallerPayloadZip)' != '' and Exists('$(InstallerPayloadZip)')">
    <EmbeddedResource Include="$(InstallerPayloadZip)"
                      LogicalName="Housekeeping.Installer.Embedded.payload.zip" />
  </ItemGroup>

  <ItemGroup Condition="'$(InstallerMetadataJson)' != '' and Exists('$(InstallerMetadataJson)')">
    <EmbeddedResource Include="$(InstallerMetadataJson)"
                      LogicalName="Housekeeping.Installer.Embedded.metadata.json" />
  </ItemGroup>

</Project>
