<Project>

  <PropertyGroup>
    <Product>Housekeeping</Product>
    <Version>0.2.0</Version>
    <InformationalVersion>0.2.0</InformationalVersion>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)\=.</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(HousekeepingTestAutomation)' == 'true'">
    <DefineConstants>$(DefineConstants);HOUSEKEEPING_TEST_AUTOMATION</DefineConstants>
  </PropertyGroup>

</Project>
