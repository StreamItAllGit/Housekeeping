<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Housekeeping</AssemblyName>
    <RootNamespace>Housekeeping.Launcher</RootNamespace>
    <ApplicationIcon>..\Housekeeping.DesktopHost\Assets\app_icon.ico</ApplicationIcon>
    <Title>Housekeeping</Title>
    <Product>Housekeeping</Product>
    <Company>StreamItAll</Company>
    <PublishSingleFile Condition="'$(PublishAot)' != 'true' and '$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Foundation.Launcher">
      <HintPath>..\lib\Foundation.Launcher.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
