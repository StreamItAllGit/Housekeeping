<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Housekeeping</AssemblyName>
    <RootNamespace>Housekeeping.Launcher</RootNamespace>
    <ApplicationIcon>..\Housekeeping.DesktopHost\Assets\app_icon.ico</ApplicationIcon>
    <AssemblyTitle>Housekeeping</AssemblyTitle>
    <Product>Housekeeping</Product>
    <Company>StreamItAll</Company>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

</Project>
