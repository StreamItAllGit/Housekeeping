{
  "$schema": "https://schemas.local/suite-manifest.v2.json",
  "schemaVersion": 2,
  "manifestType": "suite-app",
  "appId": "housekeeping",
  "name": "Housekeeping",
  "shortName": "Housekeeping",
  "displayName": "Housekeeping",
  "suiteId": "mother",
  "suiteName": "Mother",
  "version": "0.2.0",
  "activeMilestone": "0.2.0",
  "goalMajorVersion": "1.0.0",
  "updatedAtUtc": "2026-11-20T00:00:00.000Z",
  "sdkVersion": "0.5.3",
  "minSuiteVersion": "0.3.0",
  "spdxLicense": "MPL-2.0",
  "installProfile": "full",
  "umbrellaSubpath": "StreamItAll\\Mother\\Housekeeping",
  "productionSubpath": "StreamItAll\\Mother\\Housekeeping",
  "appUserModelId": "StreamItAll.Housekeeping",
  "executable": "app\\Housekeeping.exe",
  "launcherExecutable": "Housekeeping.exe",
  "internalPort": 5178,
  "httpsPort": 8478,
  "brandAccent": "#f59e0b",
  "singleTrayMutex": "Global\\Mother_Housekeeping_Mutex",
  "managedEnvVar": "HOUSEKEEPING_MANAGED_BY_MOTHER",
  "workerArgs": [
    "--managed-by-suite",
    "--suite-id",
    "mother",
    "--bind",
    "127.0.0.1",
    "--port",
    "{port}"
  ],
  "residency": {
    "defaultMode": "warm",
    "allowedModes": [
      "warm",
      "cold",
      "disabled"
    ],
    "idleTimeoutMinutes": 15,
    "wakeOnApiRequest": true,
    "wakeOnUiNavigation": true,
    "wakeOnSchedule": true
  },
  "commands": {
    "startDaemon": "scripts/start-daemon.bat --managed-by-suite --bind 127.0.0.1",
    "stopDaemon": "scripts/stop-daemon.bat",
    "statusCheck": "scripts/status-check.bat",
    "backupNow": "scripts/backup-now.bat"
  },
  "endpoints": {
    "health": "/api/v1/health",
    "status": "/api/v1/pipeline/state",
    "coexistenceStatus": "/api/v1/coexistence/status",
    "telemetry": "/api/v1/system/telemetry",
    "schedulerStatus": "/api/v1/scheduler/status",
    "schedulerDefer": "/api/v1/scheduler/defer",
    "tailscaleQr": "/api/v1/system/tailscale-qr",
    "shutdown": "/api/v1/system/shutdown",
    "ui": "./"
  },
  "paths": {
    "dataDir": "data",
    "configDir": "data",
    "logDir": "logs",
    "crashesDir": "logs/crashes",
    "backupsDir": "backups"
  },
  "schedules": [],
  "targetDrives": [],
  "containerTier": "Tier A (4-Folder)",
  "ecosystemTier": "Tier2_SisterApp",
  "appArchetype": "SIS"
}
